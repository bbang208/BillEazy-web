# Claude API 키 — 이 파일을 .env 로 복사해 채우세요. (이 키는 server 에만 보관, 프론트 노출 금지)
ANTHROPIC_API_KEY=

# (선택) 헤더에 이번 달 Claude 사용 금액을 표시하려면 Admin API 키(sk-ant-admin01-…)를 넣으세요.
# 콘솔 조직 설정 필요: Console > Settings > Organization 에서 조직 생성 후 Admin Keys 발급.
ANTHROPIC_ADMIN_KEY=

# 서버 포트
PORT=8080

# CORS 허용 오리진 (콤마로 여러 개)
ALLOWED_ORIGIN=http://localhost:3000

# 크레딧 없이 UI 전체 플로우 테스트용 목(mock) 모드.
# 1 이면 /api/extract 가 실제 Claude 호출 대신 샘플 영수증 데이터를 반환.
# 크레딧 충전 후 실제 인식을 쓰려면 0 으로 바꾸거나 이 줄을 지우세요.
MOCK_EXTRACT=0

# ── 네이버 지도(주유대 출발·목적지 검색 + 경로 거리) ──
# 장소(POI) 검색: 네이버 개발자센터(developers.naver.com) 애플리케이션의 검색 API.
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=
# 경로/거리: 네이버 클라우드 플랫폼(NCP) Maps Directions 5. VPC 환경, Maps 상품 이용신청 필요.
NCP_MAPS_KEY_ID=
NCP_MAPS_KEY=
# 키 없이 지도 기능 UI/플로우 테스트용 목 모드. 1 이면 샘플 장소·거리를 반환.
MOCK_MAPS=1

# ── 하이웍스 전자결재 연동 ──
# 오피스 토큰: 오피스관리 > 서비스 연동(API) 에서 발급. 오피스 전체 권한이므로 server 에만 보관, 프론트 노출 금지.
HIWORKS_OFFICE_TOKEN=
# 기안에 사용할 양식 고유 아이디 (전자결재 > 관리자 설정 > 양식함 관리 > 양식 상세 상단)
HIWORKS_FORM_ID=
# 문서 상태 변경 콜백을 받을 서버 공개 주소(예: https://billeazy-server.up.railway.app).
# 비우면 요청 호스트로 자동 구성 — 로컬 개발에선 콜백 수신만 안 될 뿐 기안은 정상 동작.
HIWORKS_CALLBACK_URL=
